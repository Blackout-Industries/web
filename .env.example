# Blackout Industries Website - Environment Variables
#
# Copy this file to .env and configure the values for your environment.
# Note: .env is gitignored and should never be committed to version control.

# ==============================================================================
# BUILD ENVIRONMENT
# ==============================================================================

# Node environment (development | production | test)
# NODE_ENV=production


# ==============================================================================
# ANALYTICS (Optional - Future Implementation)
# ==============================================================================

# Google Tag Manager ID
# Format: GTM-XXXXXXX
# GTM_ID=GTM-XXXXXXX

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
# GA4_ID=G-XXXXXXXXXX


# ==============================================================================
# PERFORMANCE & MONITORING (Optional - Future Implementation)
# ==============================================================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry environment name
# SENTRY_ENVIRONMENT=production


# ==============================================================================
# FEATURE FLAGS (Optional - Future Implementation)
# ==============================================================================

# Enable/disable specific features
# FEATURE_BLOG=false
# FEATURE_NEWSLETTER=false
# FEATURE_LIVE_CHAT=false


# ==============================================================================
# API ENDPOINTS (Optional - Future Implementation)
# ==============================================================================

# Backend API URL (if using separate API)
# API_BASE_URL=https://api.blackoutindustries.com
# API_TIMEOUT=10000


# ==============================================================================
# DEPLOYMENT CONFIGURATION
# ==============================================================================

# Base URL for the website (used in meta tags, sitemaps, etc.)
# PUBLIC_SITE_URL=https://blackoutindustries.com

# ==============================================================================
# NOTES
# ==============================================================================
#
# - Prefix environment variables with NUXT_PUBLIC_ to make them available
#   on the client-side in Nuxt 3.
#
# - Example: NUXT_PUBLIC_GTM_ID will be available as:
#   const config = useRuntimeConfig()
#   const gtmId = config.public.gtmId
#
# - Never commit .env files with real credentials to version control.
#
# - For Docker deployments, pass environment variables using:
#   docker run --env-file .env ...
#   or in docker-compose.yml:
#     env_file:
#       - .env
#
# - For Vercel/Netlify, set environment variables in their respective dashboards.
#
# ==============================================================================
